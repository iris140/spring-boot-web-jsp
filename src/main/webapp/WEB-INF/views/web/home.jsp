<%@ page contentType="text/html;charset=UTF-8" language="java" %>

<!DOCTYPE html>
<html lang="vi">

<head>
    <title>SkyLand</title>
</head>

<body>

<section class="hero">

    <div class="hero-content">

        <div class="hero-company">
            SKYLAND CORPORATION
        </div>

        <h1>
            SkyLand Garden
        </h1>

        <p>
            SkyLand Garden là điểm kim cương hội tụ tinh hoa
            của những thành phố biểu tượng, nơi nâng tầm đẳng cấp
            thượng lưu của mỗi cư dân thành một nghệ thuật sống.
        </p>

    </div>

</section>


<section class="search-section">

    <div class="search-container">

        <div class="search-group">

            <label>Chọn tỉnh/thành phố</label>

            <select>
                <option value="">- Tỉnh/thành phố -</option>
                <option value="HCM">Hồ Chí Minh</option>
                <option value="HN">Hà Nội</option>
            </select>

        </div>


        <div class="search-group">

            <label>Chọn quận/huyện</label>

            <select>
                <option value="">- Chọn quận -</option>
            </select>

        </div>


        <div class="search-group">

            <label>Chọn loại bất động sản</label>

            <select>
                <option value="">- Loại bất động sản -</option>
                <option value="OFFICE">Văn phòng</option>
                <option value="HOUSE">Nhà</option>
                <option value="APARTMENT">Căn hộ</option>
            </select>

        </div>


        <button type="button"
                class="btn-search">
            Tìm kiếm nhanh
        </button>

    </div>

</section>


<section class="content">

    <div class="content-line"></div>

    <h2>
        Bất động sản nổi bật
    </h2>

    <p>
        Nội dung bất động sản sẽ được bổ sung sau.
    </p>

</section>

</body>

</html>